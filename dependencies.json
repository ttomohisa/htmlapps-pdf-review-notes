{
  "$schema": "./schemas/dependencies.schema.json",
  "dependencies": [
    {
      "id": "pdfjs",
      "package": "pdfjs-dist",
      "version": "6.2.108",
      "license": "Apache-2.0",
      "homepage": "https://mozilla.github.io/pdf.js/",
      "assets": [
        {
          "key": "main",
          "path": "build/pdf.min.mjs",
          "mime": "text/javascript",
          "stripSourceMapComment": true,
          "compression": "auto"
        },
        {
          "key": "worker",
          "path": "build/pdf.worker.min.mjs",
          "mime": "text/javascript",
          "stripSourceMapComment": true,
          "compression": "auto"
        },
        {
          "key": "cmap-unijis-ucs2-h",
          "path": "cmaps/UniJIS-UCS2-H.bcmap",
          "mime": "application/octet-stream",
          "compression": "auto"
        },
        {
          "key": "cmap-adobe-japan1-ucs2",
          "path": "cmaps/Adobe-Japan1-UCS2.bcmap",
          "mime": "application/octet-stream",
          "compression": "auto"
        }
      ],
      "updates": {
        "enabled": true,
        "policy": "manual"
      }
    }
  ]
}
